# ============================================================================
# VeriFact AI Research Platform — Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================================

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=VeriFact
APP_ENV=development                    # development | staging | production
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-random-64-char-string
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=verifact
POSTGRES_PASSWORD=verifact_dev_password
POSTGRES_DB=verifact
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# ── Authentication ───────────────────────────────────────────────────────────
# Google OAuth 2.0 — obtain at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-random-secret

# ── AI Provider API Keys ─────────────────────────────────────────────────────
# Google Gemini — obtain at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Groq — obtain at https://console.groq.com/keys
GROQ_API_KEY=

# Google Fact Check Tools — enable at https://console.cloud.google.com/apis
GOOGLE_FACT_CHECK_API_KEY=

# News/Search API — e.g. NewsAPI.org, SerpAPI
NEWS_API_KEY=
NEWS_API_PROVIDER=newsapi                # newsapi | serpapi | bing

# Reverse Image Search (optional)
REVERSE_IMAGE_API_KEY=
REVERSE_IMAGE_PROVIDER=

# ── Local AI ─────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ── Model Configuration ─────────────────────────────────────────────────────
MODEL_CACHE_DIR=./models
DEVICE=cpu                              # cpu | cuda | mps
MAX_MODEL_MEMORY_GB=4
LAZY_LOAD_MODELS=true

# ── Neo4j (optional, for social graph analysis) ─────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ── Application Modes ───────────────────────────────────────────────────────
DEMO_MODE=false                         # Set true only for demo/presentation use
ENABLE_REAL_AI=true                     # Use real AI models (recommended)
ENABLE_LOCAL_AI=false                   # Use local Ollama models (offline mode)

# ── CORS (production) ────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Set to your Vercel frontend URL.
CORS_ORIGINS=http://localhost:3000

# ── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS_PER_MINUTE=30
RATE_LIMIT_ANALYSES_PER_HOUR=10

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json                         # json | text
